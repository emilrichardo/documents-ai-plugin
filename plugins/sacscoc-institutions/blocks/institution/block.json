{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "sacscoc-institutions/institution",
	"title": "Institution",
	"category": "widgets",
	"icon": "id",
	"description": "One institution's record, on its own — the same page [sacscoc_institution] and /institutions/<slug>/ render, embedded anywhere.",
	"keywords": [ "sacscoc", "institution", "accreditation", "record" ],
	"textdomain": "sacscoc-institutions",
	"attributes": {
		"institutionId": { "type": "number", "default": 0 },
		"institutionName": { "type": "string", "default": "" },
		"showBack": { "type": "boolean", "default": false },
		"showAbout": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	}
}
