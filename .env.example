# Credentials for scripts/deploy-plugin.sh (and its two shortcuts,
# deploy-sacscoc.sh / deploy-ai-documents.sh) — the same four values that are
# already set as this repo's GitHub Actions secrets, under these exact names.
# `gh secret list` shows the names; the values live wherever the demo site's
# hosting access was originally shared, not here.
#
# Copy this file to .env (git-ignored — never commit real values) and fill it
# in:
#
#   cp .env.example .env
#
# The deploy scripts source .env automatically. Exporting these in your own
# shell profile instead works exactly the same way and takes priority over
# whatever is in .env.

SFTP_HOST=
SFTP_PORT=
SFTP_USERNAME=
SFTP_PASSWORD=
